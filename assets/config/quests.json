[
  {
    "id": "T01_welcome",
    "trigger": "on_new_game_start",
    "highlight": null,
    "text": "船长，欢迎来到你的新生活！在这个世界上，财富就在海浪之间。",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T01b_intro",
    "trigger": "after(T01_welcome)",
    "highlight": null,
    "text": "我们需要先赚到第一桶金。通常的做法是在物产丰富的港口低价买入，再到稀缺的地方高价卖出。",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T01c_open_port_list",
    "trigger": "after(T01b_intro)",
    "highlight": "ui.portListButton",
    "text": "点开【选择目的地】来开始我们的第一段航程。",
    "complete_when": "ui.portList.opened",
    "is_mandatory": true
  },
  {
    "id": "T01d_select_lighthouse",
    "trigger": "after(T01c_open_port_list)",
    "highlight": "ui.portRow('port_1')",
    "text": "【灯塔岛】就在附近，那里的木材非常便宜。点击【出发】！",
    "complete_when": "navigation.destination == 'port_1'",
    "is_mandatory": true
  },
  {
    "id": "T02_arrival_lighthouse",
    "trigger": "after(T01d_select_lighthouse) && navigation.arrived",
    "highlight": null,
    "text": "我们到了！灯塔岛的森林提供了源源不断的木材。",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T02b_open_market",
    "trigger": "after(T02_arrival_lighthouse)",
    "highlight": "ui.marketButton",
    "text": "打开【市场】，看看这里的木材价格。",
    "complete_when": "ui.marketPanel.opened",
    "is_mandatory": true
  },
  {
    "id": "T02c_select_wood",
    "trigger": "after(T02b_open_market)",
    "highlight": "ui.goodsRow('wood')",
    "text": "选中【木材】以准备买入。",
    "complete_when": "ui.quantitySlider.opened",
    "is_mandatory": true
  },
  {
    "id": "T02d1_adjust_quantity",
    "trigger": "after(T02c_select_wood)",
    "highlight": "ui.quantitySliderTrack",
    "text": "尽量多买一些。请将滑块调整到 10 到 50 之间。",
    "complete_when": "ui.sliderInteracted && ui.sliderValue > 10 && ui.sliderValue < 50",
    "is_mandatory": true
  },
  {
    "id": "T02d2_confirm_quantity",
    "trigger": "after(T02d1_adjust_quantity)",
    "highlight": "ui.confirmQuantityButton",
    "text": "调整滑块后点击【确认】。",
    "complete_when": "trade.pending('wood') > 10 && trade.pending('wood') < 50 && !ui.quantitySlider.opened",
    "is_mandatory": true
  },
  {
    "id": "T02e_balance_trade",
    "trigger": "after(T02d2_confirm_quantity) && trade.pending('wood') > 0",
    "highlight": "ui.balanceButton",
    "text": "点击【平衡报价】，让商人补足差额。",
    "complete_when": "ui.tradeBalanced",
    "is_mandatory": true
  },
  {
    "id": "T02f_execute_trade",
    "trigger": "after(T02e_balance_trade)",
    "highlight": "none",
    "text": "点击【确认交易】完成买入。",
    "complete_when": "cargo.count('wood') > 0",
    "action": "ui.marketPanel.close",
    "is_mandatory": true
  },
  {
    "id": "T03a_open_port_list",
    "trigger": "after(T02f_execute_trade)",
    "highlight": "ui.portListButton",
    "text": "现在我们需要找一个需要木材的地方。再次打开【选择目的地】。",
    "complete_when": "ui.portList.opened",
    "is_mandatory": true
  },
  {
    "id": "T03b_select_trading_port",
    "trigger": "after(T03a_open_port_list)",
    "highlight": "ui.portRow('port_2')",
    "text": "【贸易港】距离不远，且对木材有很大的需求。出发吧！",
    "complete_when": "navigation.destination == 'port_2'",
    "is_mandatory": true
  },
  {
    "id": "T04_arrival_trading_port",
    "trigger": "after(T03b_select_trading_port) && navigation.arrived",
    "highlight": null,
    "text": "这里就是贸易港。这里的商人愿意花大价钱买下我们的木材。",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T04b_open_market",
    "trigger": "after(T04_arrival_trading_port)",
    "highlight": "ui.marketButton",
    "text": "打开【市场】准备卖出。",
    "complete_when": "ui.marketPanel.opened",
    "is_mandatory": true
  },
  {
    "id": "T04c_select_wood",
    "trigger": "after(T04b_open_market)",
    "highlight": "ui.playerGoodsRow('wood')",
    "text": "在你的库存中选中【木材】。",
    "complete_when": "ui.quantitySlider.opened",
    "is_mandatory": true
  },
  {
    "id": "T04d1_adjust_quantity",
    "trigger": "after(T04c_select_wood)",
    "highlight": "ui.quantitySliderTrack",
    "text": "选择全部数量。拖动滑块进行调整。",
    "complete_when": "ui.sliderInteracted",
    "is_mandatory": true
  },
  {
    "id": "T04d2_confirm_quantity",
    "trigger": "after(T04d1_adjust_quantity)",
    "highlight": "ui.confirmQuantityButton",
    "text": "点击【确认】以锁定卖出数量。",
    "complete_when": "trade.pending('wood') < 0 && !ui.quantitySlider.opened",
    "is_mandatory": true
  },
  {
    "id": "T04e_balance_trade",
    "trigger": "after(T04d2_confirm_quantity) && trade.pending('wood') < 0",
    "highlight": "ui.balanceButton",
    "text": "点击【平衡报价】，看看你能赚到多少利润。",
    "complete_when": "ui.tradeBalanced",
    "is_mandatory": true
  },
  {
    "id": "T04f_execute_trade",
    "trigger": "after(T04e_balance_trade)",
    "highlight": "ui.sellButton",
    "text": "确认交易！",
    "complete_when": "cargo.count('wood') == 0",
    "action": "ui.marketPanel.close",
    "is_mandatory": true
  },
  {
    "id": "T04g_last_text",
    "trigger": "after(T04f_execute_trade)",
    "highlight": null,
    "text": "这就是贸易的魅力：利用地区间的物价差异获利。",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T10_tutorial_complete",
    "trigger": "after(T04f_execute_trade)",
    "highlight": null,
    "text": "新手引导结束了。现在，这片大海是属于你的了，船长！尽情去航行吧。",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  }
]
