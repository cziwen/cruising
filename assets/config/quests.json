[
  {
    "id": "T01_welcome",
    "trigger": "on_new_game_start",
    "highlight": null,
    "text": "船长，欢迎来到你的新生活！在这个世界上，财富就在海浪之间。",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T01b_intro",
    "trigger": "after(T01_welcome)",
    "highlight": null,
    "text": "我们需要先赚到第一桶金。通常的做法是在物产丰富的港口低价买入，再到稀缺的地方高价卖出。",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T01c_open_port_list",
    "trigger": "after(T01b_intro)",
    "highlight": "ui.portListButton",
    "text": "点开【选择目的地】来开始我们的第一段航程。",
    "complete_when": "ui.portList.opened",
    "is_mandatory": true
  },
  {
    "id": "T01d_select_lighthouse",
    "trigger": "after(T01c_open_port_list)",
    "highlight": "ui.portRow('port_1')",
    "text": "【灯塔岛】就在附近，那里的木材非常便宜。点击【出发】！",
    "complete_when": "navigation.destination == 'port_1'",
    "is_mandatory": true
  },
  {
    "id": "T02_arrival_lighthouse",
    "trigger": "after(T01d_select_lighthouse) && navigation.arrived",
    "highlight": null,
    "text": "我们到了！灯塔岛的森林提供了源源不断的木材。",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T02b_open_market",
    "trigger": "after(T02_arrival_lighthouse)",
    "highlight": "ui.marketButton",
    "text": "打开【市场】，看看这里的木材价格。",
    "complete_when": "ui.marketPanel.opened",
    "is_mandatory": true
  },
  {
    "id": "T02c_select_wood",
    "trigger": "after(T02b_open_market)",
    "highlight": "ui.goodsRow('wood')",
    "text": "选中【木材】以准备买入。",
    "complete_when": "ui.quantitySlider.opened",
    "is_mandatory": true
  },
  {
    "id": "T02d1_adjust_quantity",
    "trigger": "after(T02c_select_wood)",
    "highlight": "ui.quantitySliderTrack",
    "text": "尽量多买一些。请将滑块调整到 10 到 50 之间。",
    "complete_when": "ui.sliderInteracted && ui.sliderValue > 10 && ui.sliderValue < 50",
    "is_mandatory": true
  },
  {
    "id": "T02d2_confirm_quantity",
    "trigger": "after(T02d1_adjust_quantity)",
    "highlight": "ui.confirmQuantityButton",
    "text": "调整滑块后点击【确认】。",
    "complete_when": "trade.pending('wood') > 10 && trade.pending('wood') < 50 && !ui.quantitySlider.opened",
    "is_mandatory": true
  },
  {
    "id": "T02e_balance_trade",
    "trigger": "after(T02d2_confirm_quantity) && trade.pending('wood') > 0",
    "highlight": "ui.balanceButton",
    "text": "点击【平衡报价】，让商人补足差额。",
    "complete_when": "ui.tradeBalanced",
    "is_mandatory": true
  },
  {
    "id": "T02f_execute_trade",
    "trigger": "after(T02e_balance_trade)",
    "highlight": "ui.sellButton",
    "text": "点击【确认交易】完成买入。",
    "complete_when": "cargo.count('wood') > 0",
    "action": "ui.marketPanel.close",
    "is_mandatory": true
  },
  {
    "id": "T03a_open_port_list",
    "trigger": "after(T02f_execute_trade)",
    "highlight": "ui.portListButton",
    "text": "现在我们需要找一个需要木材的地方。再次打开【选择目的地】。",
    "complete_when": "ui.portList.opened",
    "is_mandatory": true
  },
  {
    "id": "T03b_select_trading_port",
    "trigger": "after(T03a_open_port_list)",
    "highlight": "ui.portRow('port_2')",
    "text": "【贸易港】距离不远，且对木材有很大的需求。出发吧！",
    "complete_when": "navigation.destination == 'port_2'",
    "is_mandatory": true
  },
  {
    "id": "T04_arrival_trading_port",
    "trigger": "after(T03b_select_trading_port) && navigation.arrived",
    "highlight": null,
    "text": "这里就是贸易港。这里的商人愿意花大价钱买下我们的木材。",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T04b_open_market",
    "trigger": "after(T04_arrival_trading_port)",
    "highlight": "ui.marketButton",
    "text": "打开【市场】准备卖出。",
    "complete_when": "ui.marketPanel.opened",
    "is_mandatory": true
  },
  {
    "id": "T04c_select_wood",
    "trigger": "after(T04b_open_market)",
    "highlight": "ui.playerGoodsRow('wood')",
    "text": "在你的库存中选中【木材】。",
    "complete_when": "ui.quantitySlider.opened",
    "is_mandatory": true
  },
  {
    "id": "T04d1_adjust_quantity",
    "trigger": "after(T04c_select_wood)",
    "highlight": "ui.quantitySliderTrack",
    "text": "尽可能多选一些。拖动滑块进行调整。",
    "complete_when": "ui.sliderInteracted && ui.sliderValue > 10",
    "is_mandatory": true
  },
  {
    "id": "T04d2_confirm_quantity",
    "trigger": "after(T04d1_adjust_quantity)",
    "highlight": "ui.confirmQuantityButton",
    "text": "点击【确认】以锁定卖出数量。",
    "complete_when": "trade.pending('wood') < 0 && !ui.quantitySlider.opened",
    "is_mandatory": true
  },
  {
    "id": "T04e_balance_trade",
    "trigger": "after(T04d2_confirm_quantity) && trade.pending('wood') < 0",
    "highlight": "ui.balanceButton",
    "text": "点击【平衡报价】，看看你能赚到多少利润。",
    "complete_when": "ui.tradeBalanced",
    "is_mandatory": true
  },
  {
    "id": "T04f_execute_trade",
    "trigger": "after(T04e_balance_trade)",
    "highlight": "ui.sellButton",
    "text": "确认交易！",
    "complete_when": "ui.tradeConfirmed",
    "action": "ui.marketPanel.close",
    "is_mandatory": true
  },
  {
    "id": "T04g_last_text",
    "trigger": "after(T04f_execute_trade)",
    "highlight": null,
    "text": "这就是贸易的魅力：利用地区间的物价差异获利。",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T05_free_trading",
    "trigger": "after(T04g_last_text)",
    "highlight": null,
    "text": "现在你已经掌握了贸易的基础。去广阔的大海自由航行吧！",
    "complete_when": "tap_anywhere",
    "action": "combat.unlock",
    "is_mandatory": true
  },
  {
    "id": "T06_messenger_encounter",
    "trigger": "after(T05_free_trading) && navigation.arrived && !homeIsland.opened && (player.gold >= 3000 || navigation.visited_ports_count >= 5)",
    "highlight": null,
    "text": "一位举止优雅但面带疲惫的绅士在码头拦住了你：“您好，尊敬的船长。我是【我的岛屿】的代理执政官。冒昧打扰，是因为我们正面临一个巨大的转机。”",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T06a_messenger_dialogue",
    "trigger": "after(T06_messenger_encounter)",
    "highlight": null,
    "text": "他叹了口气说道：“那座岛屿曾是这片海域的明珠，但现在由于缺乏管理而百废待兴，许多基础建设已经荒废多年，急需一位有远见的人来主持大局。”",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T06b_messenger_request",
    "trigger": "after(T06a_messenger_dialogue)",
    "highlight": null,
    "text": "“您的贸易才华已传遍各港，大家一致认为只有您这样的贸易新星才能重振岛屿的荣光。请您务必接任领主之位，去治理那片属于您的领地！”",
    "complete_when": "tap_anywhere",
    "action": "port.unlock('home_island')",
    "is_mandatory": true
  },
  {
    "id": "T06c_open_port_list",
    "trigger": "after(T06b_messenger_request)",
    "highlight": "ui.portListButton",
    "text": "打开【选择目的地】",
    "complete_when": "ui.portList.opened",
    "is_mandatory": true
  },
  {
    "id": "T06c_open_home_island",
    "trigger": "after(T06c_open_port_list)",
    "highlight": "ui.portRow('home_island')",
    "text": "选择【我的岛屿】并出发，开启你的领主治理之路吧。",
    "complete_when": "navigation.destination == 'home_island'",
    "is_mandatory": true,
    "action": "homeIsland.setTax(0)"
  },
  {
    "id": "T06d_collect_tax",
    "trigger": "after(T06c_open_home_island) && navigation.arrived",
    "highlight": null,
    "text": "领主你终于回来了！",
    "complete_when": "tap_anywhere",
    "is_mandatory": true,
    "action": "homeIsland.unlockTax && homeIsland.setTax(2000)"
  },
  {
    "id": "T06e_tax_idle",
    "trigger": "after(T06d_collect_tax)",
    "highlight": null,
    "text": "之前村民们缴纳的税金已经闲置很久了，现在终于可以派上用场了。",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T06f_collect_tax",
    "trigger": "after(T06e_tax_idle)",
    "highlight": "ui.collectTaxButton",
    "text": "点击岛屿上方的金币图标，领取用于重建岛屿的第一笔资金吧。",
    "complete_when": "homeIsland.tax_collected_today == true",
    "is_mandatory": true
  },
  {
    "id": "T06e_open_hall",
    "trigger": "after(T06d_collect_tax)",
    "highlight": "ui.hallButton",
    "text": "点击【大厅】进入岛屿的管理中心",
    "complete_when": "ui.hallPanel.opened",
    "is_mandatory": true
  },
  {
    "id": "T06f_explain_upgrade",
    "trigger": "after(T06e_open_hall)",
    "highlight": null,
    "text": "在大厅里，您可以投资金币升级岛屿的基建。随着税收、经济、资金和补货能力的提升，这座原本荒凉的岛屿将会在您的治理下焕发新生。",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  },
  {
    "id": "T06g_upgrade_logic",
    "trigger": "after(T06f_explain_upgrade)",
    "highlight": "ui.upgradeTab",
    "text": "尝试进行第一次基建升级，开启岛屿的繁荣纪元吧！",
    "complete_when": "ui.homeIslandUpgraded",
    "is_mandatory": true,
    "action": "ui.hallPanel.close"
  },
  {
    "id": "T10_tutorial_complete",
    "trigger": "after(T06g_upgrade_logic)",
    "highlight": null,
    "text": "无论是成为富甲一方的巨贾，还是建设最繁荣的领地，都由您决定。祝您航行顺利，领主大人！",
    "complete_when": "tap_anywhere",
    "is_mandatory": true
  }
]
